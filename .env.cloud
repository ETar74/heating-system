# ============================================================
#  .env.cloud — шаблон .env для облачного VPS (dev / backup-сервер)
#
#  Как использовать:
#    1) sudo ./scripts/setup-cloud.sh   (Docker, UFW, fail2ban)
#    2) cp .env.cloud .env              (заполнить значения — см. комментарии)
#    3) docker compose up -d --build
#
#  Отличия от .env.prod:
#  - У сервера публичный IP: в CORS_ORIGINS / VITE_API_URL подставить
#    публичный IP VPS (ниже — плейсхолдер 203.0.113.10).
#  - ESP32_ALLOWED_IPS НЕ задаётся — в облаке устройства ESP32 приходят
#    с разных IP (домашняя сеть, мобильная). Аутентификация — только по
#    ESP32_TOKEN.
# ============================================================

# --- API / аутентификация ---
PORT=3000

# Секрет подписи JWT (ОБЯЗАТЕЛЕН в production). Случайные 32+ байт.
# Генерация:  openssl rand -base64 48
JWT_SECRET=

# Секрет устройства ESP32 (ОБЯЗАТЕЛЕН в облаке — иначе любой клиент
# сможет писать телеметрию). Тот же токен задан в прошивке устройства.
ESP32_TOKEN=

# ⚠️ В облаке НЕ ЗАДАВАТЬ:
# ESP32_ALLOWED_IPS=

# --- Фронтенд / браузер ---
# Origins, которым разрешён CORS (адрес, с которого открывается UI).
# Заменить на публичный IP вашего VPS:
CORS_ORIGINS=http://203.0.113.10:5173

# Базовый URL API, который будет использовать фронтенд (публичный IP VPS):
VITE_API_URL=http://203.0.113.10:3000

# --- База данных ---
# Пароль Postgres, используется внутри docker-compose.yml (и в DATABASE_URL
# backend). В облаке рекомендуется задать ДО первого запуска тома:
#   openssl rand -base64 24
# Если том уже создан с дефолтом "postgres" — не менять (иначе
# backend не подключится к БД).
# POSTGRES_PASSWORD=

# --- Уведомления ---
# Токен Telegram-бота (опционально; без него бот не включается).
# TELEGRAM_BOT_TOKEN=

# --- Данные ---
# Сколько дней хранить сырую телеметрию (по умолчанию 30).
# На NVMe/SSD VPS разумно больше — например, 90.
TELEMETRY_RETENTION_DAYS=90
