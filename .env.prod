# ============================================================
#  .env.prod — шаблон .env для «живого» сервера (Orange Pi 3B и т.п.)
#
#  Как использовать:
#    1) cp .env.prod .env      (в папке проекта, рядом с docker-compose.yml)
#    2) заполнить JWT_SECRET и ESP32_TOKEN
#    3) подставить реальный статический IP Pi в CORS_ORIGINS / VITE_API_URL
# ============================================================

# --- API / аутентификация ---
PORT=3000

# Секрет подписи JWT (ОБЯЗАТЕЛЕН в production). Случайные 32+ байт.
# Генерация:  openssl rand -base64 48
JWT_SECRET=

# Секрет устройства ESP32 (ОБЯЗАТЕЛЕН в production — иначе любой
# клиент сможет писать телеметрию). Тот же токен прошивается на ESP32.
ESP32_TOKEN=

# Разрешённые IP ESP32 через запятую (опционально, ужесточает доступ).
# Пример: ESP32_ALLOWED_IPS=192.168.1.0/24
# ESP32_ALLOWED_IPS=

# --- Фронтенд / браузер ---
# Origins, которым разрешён CORS (адрес, с которого открывают UI).
CORS_ORIGINS=http://192.168.1.50:5173

# Базовый URL API, который будет использовать фронтенд (vite dev server).
# По умолчанию в docker-compose.yml — http://localhost:3000 (браузер на самом хосте).
VITE_API_URL=http://192.168.1.50:3000

# --- База данных ---
# Пароль Postgres, используется внутри docker-compose.yml (дефолт "postgres").
# Задаётся ДО первого запуска (создания тома), иначе будет конфликт с
# уже инициализированной БД. Генерация: openssl rand -base64 24
# POSTGRES_PASSWORD=

# Для запуска БЕЗ Docker (отладка на хосте). Внутри Docker не используется —
# backend берёт DATABASE_URL из docker-compose.yml (сервис postgres).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/heating_system?schema=public

# --- Уведомления ---
# Токен Telegram-бота (опционально; без него бот не включается).
# TELEGRAM_BOT_TOKEN=

# --- Данные ---
# Сколько дней хранить сырую телеметрию (по умолчанию 30).
# На SSD-хранилище разумно больше — например, 90.
TELEMETRY_RETENTION_DAYS=90
